[m[1m╭─ bash[0m
[48;5;236m[38;2;150;181;180mcd[38;2;192;197;206m agent-study/lesson6[38;2;192;197;206m[0m
[48;5;236m[38;2;143;161;179mnpm[38;2;192;197;206m start[38;2;192;197;206m --[38;2;192;197;206m [38;2;192;197;206m"[38;2;163;190;140m请阅读 src/index.js 并解释入口流程[38;2;192;197;206m"[38;2;192;197;206m[0m
